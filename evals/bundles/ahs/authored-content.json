      "protected_spans": []
    },
    {
      "copy_id": "COPY.AHS.EFFORT",
      "role": "paragraph",
      "text": "خط الأساس الحالي 120h. Light نحو 6h/day، وMedium نحو 10h/day، وHard نحو 12h/day peak؛ هذه نماذج تقويمية مشروطة وليست موعدًا مضمونًا.",
      "claim_refs": [
        "AHS.FACT.BASELINE_HOURS",
        "AHS.FACT.EFFORT_MODES"
      ],
      "protected_spans": [
        "120h",
        "6h/day",
        "10h/day",
        "12h/day peak"
      ]
    },
