        "AHS.FACT.PROJECT_POSTURE",
        "AHS.FACT.OBSERVATION_BOUNDARY"
      ],
      "protected_spans": []
    },
    {
      "copy_id": "COPY.AHS.CALLOUT",
      "role": "callout",
      "text": "القرار المتاح اليوم: إبقاء الإغلاق الإنتاجي معلّقًا. الهوية والاستعادة والأدوار والأجهزة لم يكتمل دليلها بعد.",
      "claim_refs": [
        "AHS.FACT.PROJECT_POSTURE",
        "AHS.FACT.RESTORE_STATUS"
      ],
      "protected_spans": []
    },
    {
      "copy_id": "COPY.AHS.FACTS",
      "role": "paragraph",
      "text": "الفارق بين السجلين، مع حجم المحتوى والعلاقات، يحدد عبء التحقق قبل الإغلاق.",
      "claim_refs": [],
      "protected_spans": []
    },
    {
      "copy_id": "COPY.AHS.TECH",
      "role": "paragraph",
      "text": "المسار المرصود /opt/ahs/core يعمل على PostgreSQL 16.13 وقاعدة ahs_prod. فحص manage.py check اكتمل مع staticfiles.W004؛ وملف النسخ يحمل تاريخ 2026-04-20.",
      "claim_refs": [
        "AHS.FACT.RUNTIME_PATH",
        "AHS.FACT.DATABASE",
        "AHS.FACT.RUNTIME_CHECK",
        "AHS.FACT.BACKUP_DATE"
      ],
      "protected_spans": [
        "/opt/ahs/core",
