      ],
      "presentation_intent": "comparison",
      "structured_blocks": [
        {
          "block_id": "STRUCT.AHS.EFFORT",
          "type": "fact_list",
          "title": "Three pace options",
          "claim_refs": [
            "AHS.FACT.EFFORT_MODES"
          ],
          "items": [
            {
              "label": "Light",
              "value": "≈ 6h/day · ≈ 20 working days",
              "detail": "Lighter pace; the acceptance standard stays fixed.",
              "claim_refs": [
                "AHS.FACT.EFFORT_MODES"
              ]
            },
            {
              "label": "Medium",
              "value": "≈ 10h/day · ≈ 12 working days",
              "detail": "Tighter coordination; the acceptance standard stays fixed.",
              "claim_refs": [
                "AHS.FACT.EFFORT_MODES"
              ]
            },
            {
              "label": "Hard",
              "value": "≈ 12h/day peak · ≈ 10 working days",
              "detail": "Higher pressure; waiting time does not disappear.",
              "claim_refs": [
                "AHS.FACT.EFFORT_MODES"
              ]
            }
          ]
        }
      ]
    },
