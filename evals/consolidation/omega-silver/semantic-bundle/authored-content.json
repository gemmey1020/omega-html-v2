  "blocks": [
    {
      "copy_id": "COPY.AHS.HEADLINE",
      "role": "headline",
      "text": "AHS: the operational truth before closure",
      "claim_refs": [
        "AHS.FACT.PROJECT_POSTURE"
      ],
      "protected_spans": []
    },
    {
      "copy_id": "COPY.AHS.SUBHEAD",
      "role": "subheadline",
      "text": "The local reading makes the observed state clear. Production closure still waits for decisive acceptance tests.",
      "claim_refs": [
        "AHS.FACT.PROJECT_POSTURE",
        "AHS.FACT.OBSERVATION_BOUNDARY"
      ],
      "protected_spans": []
    },
    {
      "copy_id": "COPY.AHS.CALLOUT",
      "role": "callout",
      "text": "Keep production closure conditional until identity, recovery, roles, and device acceptance are complete.",
      "claim_refs": [
        "AHS.FACT.PROJECT_POSTURE",
        "AHS.FACT.RESTORE_STATUS"
      ],
      "protected_spans": []
    },
    {
      "copy_id": "COPY.AHS.FACTS",
      "role": "paragraph",
      "text": "The gap between the two user records, together with content and relationship volume, sets the verification load before closure.",
      "claim_refs": [],
      "protected_spans": []
    },
    {
      "copy_id": "COPY.AHS.MIGRATION_BOUNDARY",
      "role": "callout",
      "text": "The requirements mention migration from the old server to a new production server. The available package does not identify, describe, or provide an access point for that server, so the migration target remains unknown.",
      "claim_refs": [
        "AHS.REQUIREMENT.12",
        "AHS.FACT.MIGRATION_TARGET"
      ],
      "protected_spans": []
    },
    {
      "copy_id": "COPY.AHS.EFFORT",
      "role": "paragraph",
      "text": "The current 120h total is a planning baseline for the discovered scope, not a guaranteed date. Light is about 6h/day, Medium about 10h/day, and Hard about 12h/day peak; external waiting time is added rather than compressed.",
      "claim_refs": [
        "AHS.FACT.BASELINE_HOURS",
        "AHS.FACT.EFFORT_MODES"
      ],
      "protected_spans": [
        "120h",
        "6h/day",
        "10h/day",
        "12h/day peak"
      ]
    },
